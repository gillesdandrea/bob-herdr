#!/bin/sh
# bob shim from bob-herdr. Runs the real Bob and, inside an hc terminal or a
# Rex block: reports Bob's trust question and sign-in screen as `blocked`,
# reports `idle` once Bob's input box is on screen, unless Bob starts with a
# prompt (`bob "fix the tests"`), and clears the status on exit. In a
# terminal that sets OSC7577_TOKEN, it also tells the terminal how to resume
# Bob (the Program Resume Protocol, see lib/resume.mjs).

self=$(realpath "$0")
root=$(dirname "$(dirname "$self")")
. "$root/lib/status.sh"

# The marker on line 2 of this file. Bob's own entry point is megabytes of
# minified code on a few lines, so only the first bytes are read.
is_shim() {
  head -c 512 "$1" 2>/dev/null | grep -q 'bob shim from bob-herdr'
}

# The first bob on PATH that is not a bob-herdr shim, copies included.
real_bob() {
  if [ -n "${BOB_HERDR_BOB:-}" ]; then
    if is_shim "$BOB_HERDR_BOB"; then
      echo "bob-herdr: BOB_HERDR_BOB is a bob-herdr shim; point it at the real Bob" >&2
      return 1
    fi
    printf '%s\n' "$BOB_HERDR_BOB"
    return
  fi
  old_ifs=$IFS
  IFS=:
  for dir in $PATH; do
    [ -n "$dir" ] && [ -f "$dir/bob" ] && [ -x "$dir/bob" ] || continue
    is_shim "$dir/bob" && continue
    IFS=$old_ifs
    printf '%s\n' "$dir/bob"
    return
  done
  IFS=$old_ifs
  echo "bob-herdr: no bob found on PATH, apart from the bob-herdr shim" >&2
  return 1
}

bob=$(real_bob) || exit 127

# The token stays in the shim's memory: Bob, its hooks and the commands it
# runs do not get it, so only the shim can tell the terminal what to resume.
# A BOB_HERDR_STATE from outside belongs to another Bob, one that runs this
# one: this Bob must not report as that one.
resume_token=${OSC7577_TOKEN:-}
unset OSC7577_TOKEN BOB_HERDR_STATE

# Help, version, a headless prompt and Bob's listings, anywhere before `--`,
# run as they are.
for arg do
  case $arg in
    --) break ;;
    -p | --prompt | --prompt=* | -h | --help | -v | --version | --list-tasks | --list-tasks=* | --show-license)
      exec "$bob" "$@"
      ;;
  esac
done

# Bob's options that take a value, and those that take none: those of Bob
# 2.1.0, and those that `bob-herdr install` read from Bob's help, on the
# first and second line of the file.
value_options='--instance-id --workspace --config-dir --mode --max-cost --max-turns --log-level --team-id --disable-tool-groups'
flag_options='--auto-approve --disable-mcp --disable-subagents --trust --accept-license'
options_file=${BOB_HERDR_OPTIONS:-${XDG_CONFIG_HOME:-$HOME/.config}/bob-herdr/value-options}
recorded=
recorded_flags=
if [ -r "$options_file" ]; then
  {
    read -r recorded
    read -r recorded_flags
  } <"$options_file" || :
fi
value_options="$value_options $recorded"
flag_options="$flag_options $recorded_flags"

# Bob gets its arguments as they are. The shim only checks what they hold.
# Options and the values of the options above are skipped; after `--`,
# nothing is an option. Bob reads the first remaining word as a command when
# it names one, even after `--`: its headless and management commands run as
# they are, and `chat` is not a prompt. Any other word is a prompt.
#
# The resume command is the shim, by the path it was started with, and the
# options with their values: no prompt, which must not run twice, and no
# `-r`, which the reports add with the current task. An option the shim does
# not know may take the next word as its value, or not: the shim cannot tell
# its value from the prompt, so it reports nothing.
prompt=
value=
word=
rest=
resume_id=
resume_argv=
if [ -n "$resume_token" ]; then
  case $0 in
    /*) resume_argv=$(b64 "$0") ;;
    *) resume_argv=$(b64 "$self") ;;
  esac
fi
keep() {
  [ -z "$resume_token" ] || resume_argv="$resume_argv,$(b64 "$1")"
}
for arg do
  if [ -z "$rest" ]; then
    if [ "$value" = 1 ]; then
      value=
      keep "$arg"
      continue
    fi
    if [ "$value" = resume ]; then
      value=
      # Bob reads the word after -r as a task id, unless it is an option.
      case $arg in
        -*) ;;
        *)
          resume_id=$arg
          continue
          ;;
      esac
    fi
    case " $value_options " in
      *" $arg "*)
        value=1
        keep "$arg"
        continue
        ;;
    esac
    case $arg in
      --)
        rest=1
        continue
        ;;
      -r | --resume)
        value=resume
        continue
        ;;
      --resume=*)
        resume_id=${arg#--resume=}
        continue
        ;;
      -*=*)
        keep "$arg"
        continue
        ;;
      -*)
        case " $flag_options " in
          *" $arg "*) keep "$arg" ;;
          *) resume_token= ;;
        esac
        continue
        ;;
    esac
  fi
  [ -n "$arg" ] || continue
  if [ -z "$word" ]; then
    word=1
    case $arg in
      run | mcp | extension | acp) exec "$bob" "$@" ;;
      chat) continue ;;
    esac
  fi
  prompt=1
done

status=
status_enabled && status=1
[ -n "$status" ] || [ -n "$resume_token" ] || exec "$bob" "$@"

# A helper watches Bob's screen while Bob starts, looking about twice a
# second until Bob's input box is up. It reads the screen with `hc read` in
# an hc terminal and `rex capture` in a Rex block. In any other terminal
# there is no helper: no idle at launch, and no trust or sign-in report.
#
# Before its input box, Bob may stop at a question: whether to trust the
# folder, or its sign-in screen. The helper reports each as blocked while it
# is on screen, and clears that report when the question goes: in a folder
# you do not trust, no hook follows to replace it.
#
# Once the input box is up, the helper reports idle if Bob started without a
# prompt. With a prompt it reports nothing: idle would end an `hc wait`
# early, and Bob's hook reports working once Bob has the prompt.
#
# An earlier program may have left one of these texts on the screen. The
# first look comes before Bob draws, and if it shows one of them, nothing
# counts until a look shows none, which is Bob clearing the screen.
#
# The helper, the shim and Bob's hooks share a folder, BOB_HERDR_STATE: `pid`
# holds Bob's process id, `exited` appears once Bob has exited, and `last`
# holds the last report, from the helper or a hook. The helper checks `pid`
# and `exited` before it reports, so it never reports for a Bob that is gone,
# and reads `last` so it never replaces a hook's report.
state=
helper=
ready=${BOB_HERDR_READY_TEXT:-/ for commands}
signin=${BOB_HERDR_SIGNIN_TEXT:-Complete sign-in in your browser|in your browser to sign in}
trust=${BOB_HERDR_TRUST_TEXT:-Do you trust this folder}
bob_alive() {
  [ ! -e "$state/exited" ] && [ -s "$state/pid" ] && kill -0 "$(cat "$state/pid")" 2>/dev/null
}
stop_helper() {
  if [ -n "$helper" ]; then
    { : >"$state/exited"; } 2>/dev/null
    pkill -P "$helper" 2>/dev/null
    kill "$helper" 2>/dev/null
    wait "$helper" 2>/dev/null
  fi
  [ -z "$state" ] || rm -rf "$state"
}
# The screen and about 40 lines above it, as `hc read --lines 40` gives.
# In Rex, the capture holds the whole scrollback, then every row of the
# screen, blank ones included, in escape sequences: the plain text format
# leaves out the blank rows at the bottom, so its last lines are not the
# screen. The sequences are removed, and so are the carriage returns.
esc=$(printf '\033')
bel=$(printf '\007')
cr=$(printf '\r')
plain="s#$esc\\][^$bel$esc]*($bel|$esc\\\\)##g; s#$esc\\[[0-9;:?<=>]*[ -/]*[@-~]##g; s#$esc[ -/]*[0-~]##g; s#$cr\$##"
look() {
  case $terminal in
    hc)
      # Without HC_TERMINAL_ID, hc acts for nobody.
      env -u HC_TERMINAL_ID hc read "$term" --lines 40
      ;;
    rex)
      rows=$(stty size </dev/tty 2>/dev/null) && rows=${rows%% *} || rows=
      case $rows in
        '' | *[!0-9]*) rows=$(rex block call -b "$term" size 2>/dev/null | sed -n 's/.*"rows":\([0-9][0-9]*\).*/\1/p') ;;
      esac
      [ -n "$rows" ] || return 1
      all=$(rex capture -b "$term" --format vt) || return 1
      printf '%s\n' "$all" | tail -n $((rows + 40)) | LC_ALL=C sed -E "$plain"
      ;;
  esac
}
last_report() {
  last=
  { read -r last <"$state/last"; } 2>/dev/null || :
}
status_terminal
case $terminal in
  hc) term=$HC_TERMINAL_ID ;;
  rex) term=$REX_BLOCK ;;
esac
watch=
[ -n "$status" ] && [ -n "$terminal" ] && command -v "$terminal" >/dev/null 2>&1 && watch=1
# resume_send report [task id] | clear: an OSC 7577 report from the shim,
# which owns the record, so it lives as long as Bob does. The token goes to
# node on its stdin; printf is a shell builtin, so the token never shows in
# the process list.
resume_send() {
  printf '%s\n' "$$" "$resume_argv" "$resume_cwd" "$resume_token" | node "$root/lib/resume.mjs" "$@"
}
# Bob's hooks write the task to resume, or an empty line for a fresh Bob, to
# $state/task, and signal the shim, which reports it.
resume_task() {
  task=
  { read -r task <"$state/task"; } 2>/dev/null || :
  resume_send report "$task"
}

if [ -n "$watch" ] || [ -n "$resume_token" ]; then
  # Until Bob runs, Ctrl-C ends the shim: the helper must not outlive it,
  # and no record must outlive the shim.
  trap '[ -z "$resume_token" ] || resume_send clear; stop_helper; exit 130' INT
  # A shim that was killed leaves its folder behind: remove the folders
  # whose shim, or whose Bob for an older shim, is gone.
  for old in "${TMPDIR:-/tmp}"/bob-herdr.*; do
    old_pid=
    { read -r old_pid <"$old/resume" || read -r old_pid <"$old/pid"; } 2>/dev/null || continue
    [ -n "$old_pid" ] && ! kill -0 "$old_pid" 2>/dev/null && rm -rf "$old"
  done
  state=$(mktemp -d "${TMPDIR:-/tmp}/bob-herdr.XXXXXX")
  export BOB_HERDR_STATE="$state"
fi

# The shim reports a fresh Bob, or the task given with -r, before Bob
# starts; Bob's hooks hand it each task once Bob has one. $state/resume,
# the shim's process id, tells the hooks where to send it.
if [ -n "$resume_token" ]; then
  resume_cwd=$(b64 "$PWD")
  trap resume_task USR1
  echo "$$" >"$state/resume"
  resume_send report "$resume_id"
fi

if [ -n "$watch" ]; then
  (
    trap '' INT
    fresh=
    asked=
    looks=$((${BOB_HERDR_READY_TIMEOUT:-600} * 2))
    while [ "$looks" -gt 0 ] && [ ! -e "$state/exited" ]; do
      looks=$((looks - 1))
      # A look that fails says nothing about the screen.
      if ! screen=$(look 2>/dev/null); then
        sleep 0.5
        continue
      fi
      found=
      if printf '%s' "$screen" | grep -Eq "$trust"; then
        found=trust
      elif printf '%s' "$screen" | grep -Eq "$signin"; then
        found=signin
      else
        case $screen in
          *"$ready"*) found=ready ;;
        esac
      fi
      if [ -z "$fresh" ]; then
        if [ -n "$found" ]; then
          sleep 0.3
          continue
        fi
        fresh=1
      fi
      if [ -n "$asked" ] && [ "$found" != "$asked" ]; then
        # Only our own report: a hook may have reported since.
        last_report
        [ "$last" != "$sent" ] || report "state=clear"
        asked=
      fi
      case $found in
        ready)
          if [ -z "$prompt" ] && bob_alive; then
            # Text typed before the input box was up may already be a
            # prompt: a hook's working or blocked report stays.
            last_report
            case $last in
              state=working* | state=blocked*) ;;
              *) report "state=idle:app=bob" ;;
            esac
          fi
          exit 0
          ;;
        trust)
          kind=permission
          msg='Bob asks whether to trust this folder'
          ;;
        signin)
          kind=auth
          msg='Sign in to Bob in your browser'
          ;;
      esac
      if [ -n "$found" ] && [ "$found" != "$asked" ]; then
        bob_alive || exit 0
        sent="state=blocked:kind=$kind:app=bob:msg=$(printf '%s' "$msg" | base64 | tr -d '\n')"
        report "$sent"
        asked=$found
      fi
      # In Rex each look copies the block's whole scrollback. While a
      # question waits on a person, look every 2.5 seconds, which counts as
      # five looks against the timeout.
      if [ -n "$asked" ] && [ "$terminal" = rex ]; then
        sleep 2.5
        looks=$((looks - 4))
      else
        sleep 0.5
      fi
    done
  ) 2>/dev/null &
  helper=$!
fi

# Bob runs in the background so the shim knows its process id. Its stdin is
# the terminal (saved in fd 3), not the /dev/null a background job gets.
# From here on Ctrl-C is Bob's: it shares the terminal's process group.
exec 3<&0
trap : INT
"$bob" "$@" <&3 3<&- &
bob_pid=$!
exec 3<&-
[ -z "$state" ] || echo "$bob_pid" >"$state/pid"

# TERM and HUP for the shim go to Bob; the cleanup below runs once Bob exits.
hangup=
trap 'hangup=1; kill -TERM "$bob_pid" 2>/dev/null' TERM
trap 'hangup=1; kill -HUP "$bob_pid" 2>/dev/null' HUP
while :; do
  wait "$bob_pid"
  rc=$?
  kill -0 "$bob_pid" 2>/dev/null || break
done
trap '' USR1

# The resume record goes when you end Bob. A hangup or a TERM, for Bob or
# the shim, means the terminal is going away, which is when it needs the
# record.
if [ -n "$resume_token" ] && [ -z "$hangup" ]; then
  case $rc in
    129 | 143) ;;
    *) resume_send clear ;;
  esac
fi
stop_helper
[ -z "$status" ] || report "state=clear"
exit $rc
