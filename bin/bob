#!/bin/sh
# bob shim from bob-herdr. Runs the real Bob and, inside an hc terminal:
# reports `idle` once Bob's input box is on screen, unless Bob starts with a
# prompt (`bob "fix the tests"`), where it reports a sign-in screen as
# `blocked` instead, and clears the status on exit.

self=$(realpath "$0")
root=$(dirname "$(dirname "$self")")
. "$root/lib/status.sh"

# The marker on line 2 of this file. Bob's own entry point is megabytes of
# minified code on a few lines, so only the first bytes are read.
is_shim() {
  head -c 512 "$1" 2>/dev/null | grep -q 'bob shim from bob-herdr'
}

# The first bob on PATH that is not a bob-herdr shim, copies included.
real_bob() {
  if [ -n "${BOB_HERDR_BOB:-}" ]; then
    if is_shim "$BOB_HERDR_BOB"; then
      echo "bob-herdr: BOB_HERDR_BOB is a bob-herdr shim; point it at the real Bob" >&2
      return 1
    fi
    printf '%s\n' "$BOB_HERDR_BOB"
    return
  fi
  old_ifs=$IFS
  IFS=:
  for dir in $PATH; do
    [ -n "$dir" ] && [ -f "$dir/bob" ] && [ -x "$dir/bob" ] || continue
    is_shim "$dir/bob" && continue
    IFS=$old_ifs
    printf '%s\n' "$dir/bob"
    return
  done
  IFS=$old_ifs
  echo "bob-herdr: no bob found on PATH, apart from the bob-herdr shim" >&2
  return 1
}

bob=$(real_bob) || exit 127

# Help, version, a headless prompt and Bob's listings, anywhere before `--`,
# run as they are.
for arg do
  case $arg in
    --) break ;;
    -p | --prompt | --prompt=* | -h | --help | -v | --version | --list-tasks | --list-tasks=* | --show-license)
      exec "$bob" "$@"
      ;;
  esac
done

# Bob gets its arguments as they are. The shim only checks what they hold.
# Options and the values of Bob 2.1.0's options are skipped; after `--`,
# nothing is an option. Bob reads the first remaining word as a command when
# it names one, even after `--`: its headless and management commands run as
# they are, and `chat` is not a prompt. Any other word is a prompt.
prompt=
value=
word=
rest=
for arg do
  if [ -z "$rest" ]; then
    if [ "$value" = 1 ]; then
      value=
      continue
    fi
    if [ "$value" = resume ]; then
      value=
      # Bob reads the word after -r as a task id, unless it is an option.
      case $arg in
        -*) ;;
        *) continue ;;
      esac
    fi
    case $arg in
      --)
        rest=1
        continue
        ;;
      --instance-id | --workspace | --config-dir | --mode | --max-cost | --max-turns | --log-level | --team-id | --disable-tool-groups)
        value=1
        continue
        ;;
      -r | --resume)
        value=resume
        continue
        ;;
      -*) continue ;;
    esac
  fi
  [ -n "$arg" ] || continue
  if [ -z "$word" ]; then
    word=1
    case $arg in
      run | mcp | extension | acp) exec "$bob" "$@" ;;
      chat) continue ;;
    esac
  fi
  prompt=1
done

status_enabled || exec "$bob" "$@"

# A helper watches Bob's screen through hc while Bob starts.
#
# Without a prompt, it reports idle once Bob's input box is on screen. With a
# prompt, idle would end an `hc wait` early, and Bob's hook reports working
# once Bob has the prompt. Until then Bob may stop at its sign-in screen: the
# helper reports that as blocked. Only with a prompt, which Bob itself sends
# after sign-in: herdr-core drops a template's first message when the first
# status is blocked.
#
# The helper and the shim share a folder: `pid` holds Bob's process id, and
# `exited` appears once Bob has exited. The helper checks both before it
# reports, so it never reports for a Bob that is gone.
state=
helper=
ready=${BOB_HERDR_READY_TEXT:-/ for commands}
signin=${BOB_HERDR_SIGNIN_TEXT:-Complete sign-in in your browser|in your browser to sign in}
bob_alive() {
  [ ! -e "$state/exited" ] && [ -s "$state/pid" ] && kill -0 "$(cat "$state/pid")" 2>/dev/null
}
stop_helper() {
  if [ -n "$helper" ]; then
    : >"$state/exited"
    pkill -P "$helper" 2>/dev/null
    kill "$helper" 2>/dev/null
    wait "$helper" 2>/dev/null
  fi
  [ -z "$state" ] || rm -rf "$state"
}
if [ -n "${HC_TERMINAL_ID:-}" ] && command -v hc >/dev/null 2>&1; then
  # Until Bob runs, Ctrl-C ends the shim: the helper must not outlive it.
  trap 'stop_helper; exit 130' INT
  state=$(mktemp -d "${TMPDIR:-/tmp}/bob-herdr.XXXXXX")
  term=$HC_TERMINAL_ID
  # Without HC_TERMINAL_ID, hc acts for nobody: a message to this terminal
  # does not end a wait.
  if [ -z "$prompt" ]; then
    (
      trap '' INT
      # Piped, not captured: hc stays a direct child, which the shim kills
      # when Bob exits. A timeout also exits 0, hence the reason check.
      env -u HC_TERMINAL_ID hc wait "$term" --json --output "$ready" \
        --timeout "${BOB_HERDR_READY_TIMEOUT:-600}" 2>/dev/null |
        grep -q '"reason":"output"' || exit 0
      bob_alive || exit 0
      report "state=idle:app=bob"
    ) 2>/dev/null &
    helper=$!
    # `hc wait --output` only sees output printed after it starts listening.
    # Bob takes over a second to draw its input box; this head start covers
    # the time hc needs to connect.
    sleep 0.3
  else
    (
      trap '' INT
      # The sign-in screen never comes once the input box is up, so the
      # helper looks about once a second until then. An earlier program may
      # have left either text on the screen: the first look comes before
      # Bob draws, and if it shows one of them, nothing counts until a look
      # shows neither, which is Bob clearing the screen.
      fresh=
      tries=0
      while [ "$tries" -lt "${BOB_HERDR_READY_TIMEOUT:-600}" ] && [ ! -e "$state/exited" ]; do
        tries=$((tries + 1))
        screen=$(env -u HC_TERMINAL_ID hc read "$term" --lines 40 2>/dev/null)
        found=
        case $screen in
          *"$ready"*) found=ready ;;
        esac
        [ -n "$found" ] || ! printf '%s' "$screen" | grep -Eq "$signin" || found=signin
        if [ -z "$fresh" ]; then
          if [ -n "$found" ]; then
            sleep 0.3
            continue
          fi
          fresh=1
        fi
        [ "$found" != ready ] || exit 0
        if [ "$found" = signin ]; then
          bob_alive || exit 0
          report "state=blocked:kind=auth:app=bob:msg=$(printf 'Sign in to Bob in your browser' | base64 | tr -d '\n')"
          exit 0
        fi
        sleep 1
      done
    ) 2>/dev/null &
    helper=$!
  fi
fi

# Bob runs in the background so the shim knows its process id. Its stdin is
# the terminal (saved in fd 3), not the /dev/null a background job gets.
# From here on Ctrl-C is Bob's: it shares the terminal's process group.
exec 3<&0
trap : INT
"$bob" "$@" <&3 3<&- &
bob_pid=$!
exec 3<&-
[ -z "$state" ] || echo "$bob_pid" >"$state/pid"

# TERM and HUP for the shim go to Bob; the cleanup below runs once Bob exits.
trap 'kill -TERM "$bob_pid" 2>/dev/null' TERM
trap 'kill -HUP "$bob_pid" 2>/dev/null' HUP
while :; do
  wait "$bob_pid"
  rc=$?
  kill -0 "$bob_pid" 2>/dev/null || break
done

stop_helper
report "state=clear"
exit $rc
