#!/bin/sh
# bob shim from bob-herdr. Runs the real Bob and, inside an hc terminal:
# reports `idle` once Bob's input box is on screen, unless Bob starts with a
# prompt (`bob "fix the tests"`), and clears the status on exit.

self=$(realpath "$0")
root=$(dirname "$(dirname "$self")")
. "$root/lib/status.sh"

# The marker on line 2 of this file. Bob's own entry point is megabytes of
# minified code on a few lines, so only the first bytes are read.
is_shim() {
  head -c 512 "$1" 2>/dev/null | grep -q 'bob shim from bob-herdr'
}

# The first bob on PATH that is not a bob-herdr shim, copies included.
real_bob() {
  if [ -n "${BOB_HERDR_BOB:-}" ]; then
    if is_shim "$BOB_HERDR_BOB"; then
      echo "bob-herdr: BOB_HERDR_BOB is a bob-herdr shim; point it at the real Bob" >&2
      return 1
    fi
    printf '%s\n' "$BOB_HERDR_BOB"
    return
  fi
  old_ifs=$IFS
  IFS=:
  for dir in $PATH; do
    [ -n "$dir" ] && [ -f "$dir/bob" ] && [ -x "$dir/bob" ] || continue
    is_shim "$dir/bob" && continue
    IFS=$old_ifs
    printf '%s\n' "$dir/bob"
    return
  done
  IFS=$old_ifs
  echo "bob-herdr: no bob found on PATH, apart from the bob-herdr shim" >&2
  return 1
}

bob=$(real_bob) || exit 127

# Help, version, a headless prompt and Bob's listings, anywhere, run as they
# are.
for arg do
  case $arg in
    -p | --prompt | --prompt=* | -h | --help | -v | --version | --list-tasks | --list-tasks=* | --show-license)
      exec "$bob" "$@"
      ;;
  esac
done

# Bob gets its arguments as they are. The shim only checks what they hold.
# Options and the values of Bob 2.1.0's options are skipped; after `--`,
# nothing is an option. Bob reads the first remaining word as a command when
# it names one, even after `--`: its headless and management commands run as
# they are, and `chat` is not a prompt. Any other word is a prompt.
prompt=
value=
word=
rest=
for arg do
  if [ -z "$rest" ]; then
    if [ "$value" = 1 ]; then
      value=
      continue
    fi
    if [ "$value" = resume ]; then
      value=
      # Bob reads the word after -r as a task id, unless it is an option.
      case $arg in
        -*) ;;
        *) continue ;;
      esac
    fi
    case $arg in
      --)
        rest=1
        continue
        ;;
      --instance-id | --workspace | --config-dir | --mode | --max-cost | --max-turns | --log-level | --team-id | --disable-tool-groups)
        value=1
        continue
        ;;
      -r | --resume)
        value=resume
        continue
        ;;
      -*) continue ;;
    esac
  fi
  [ -n "$arg" ] || continue
  if [ -z "$word" ]; then
    word=1
    case $arg in
      run | mcp | extension | acp) exec "$bob" "$@" ;;
      chat) continue ;;
    esac
  fi
  prompt=1
done

status_enabled || exec "$bob" "$@"

# Without a prompt, a helper reports idle once Bob's input box is on screen,
# which needs hc. With a prompt, nothing is reported here: Bob's hook reports
# working once Bob has the prompt, and an idle report before that would end
# an `hc wait` early.
#
# The helper and the shim share a folder: `pid` holds Bob's process id, and
# `exited` appears once Bob has exited. The helper checks both before it
# reports, so it never reports for a Bob that is gone.
state=
helper=
stop_helper() {
  if [ -n "$helper" ]; then
    : >"$state/exited"
    pkill -P "$helper" 2>/dev/null
    kill "$helper" 2>/dev/null
    wait "$helper" 2>/dev/null
  fi
  [ -z "$state" ] || rm -rf "$state"
}
if [ -z "$prompt" ] && [ -n "${HC_TERMINAL_ID:-}" ] && command -v hc >/dev/null 2>&1; then
  # Until Bob runs, Ctrl-C ends the shim: the helper must not outlive it.
  trap 'stop_helper; exit 130' INT
  state=$(mktemp -d "${TMPDIR:-/tmp}/bob-herdr.XXXXXX")
  term=$HC_TERMINAL_ID
  (
    trap '' INT
    # Without HC_TERMINAL_ID, hc acts for nobody: a message to this terminal
    # does not end the wait. Piped, not captured: hc stays a direct child,
    # which the shim kills when Bob exits. A timeout also exits 0, hence the
    # reason check.
    env -u HC_TERMINAL_ID hc wait "$term" --json \
      --output "${BOB_HERDR_READY_TEXT:-/ for commands}" \
      --timeout "${BOB_HERDR_READY_TIMEOUT:-600}" 2>/dev/null |
      grep -q '"reason":"output"' || exit 0
    [ ! -e "$state/exited" ] && [ -s "$state/pid" ] && kill -0 "$(cat "$state/pid")" 2>/dev/null || exit 0
    report "state=idle:app=bob"
  ) 2>/dev/null &
  helper=$!
  # `hc wait --output` only sees output printed after it starts listening.
  # Bob takes over a second to draw its input box; this head start covers
  # the time hc needs to connect.
  sleep 0.3
fi

# Bob runs in the background so the shim knows its process id. Its stdin is
# the terminal (saved in fd 3), not the /dev/null a background job gets.
# From here on Ctrl-C is Bob's: it shares the terminal's process group.
exec 3<&0
trap : INT
"$bob" "$@" <&3 3<&- &
bob_pid=$!
exec 3<&-
[ -z "$state" ] || echo "$bob_pid" >"$state/pid"

# TERM and HUP for the shim go to Bob; the cleanup below runs once Bob exits.
trap 'kill -TERM "$bob_pid" 2>/dev/null' TERM
trap 'kill -HUP "$bob_pid" 2>/dev/null' HUP
while :; do
  wait "$bob_pid"
  rc=$?
  kill -0 "$bob_pid" 2>/dev/null || break
done

stop_helper
report "state=clear"
exit $rc
