#!/bin/sh
# bob shim from bob-herdr. Runs the real Bob and, inside an hc terminal:
# reports Bob's trust question and sign-in screen as `blocked`, reports `idle`
# once Bob's input box is on screen, unless Bob starts with a prompt
# (`bob "fix the tests"`), and clears the status on exit.

self=$(realpath "$0")
root=$(dirname "$(dirname "$self")")
. "$root/lib/status.sh"

# The marker on line 2 of this file. Bob's own entry point is megabytes of
# minified code on a few lines, so only the first bytes are read.
is_shim() {
  head -c 512 "$1" 2>/dev/null | grep -q 'bob shim from bob-herdr'
}

# The first bob on PATH that is not a bob-herdr shim, copies included.
real_bob() {
  if [ -n "${BOB_HERDR_BOB:-}" ]; then
    if is_shim "$BOB_HERDR_BOB"; then
      echo "bob-herdr: BOB_HERDR_BOB is a bob-herdr shim; point it at the real Bob" >&2
      return 1
    fi
    printf '%s\n' "$BOB_HERDR_BOB"
    return
  fi
  old_ifs=$IFS
  IFS=:
  for dir in $PATH; do
    [ -n "$dir" ] && [ -f "$dir/bob" ] && [ -x "$dir/bob" ] || continue
    is_shim "$dir/bob" && continue
    IFS=$old_ifs
    printf '%s\n' "$dir/bob"
    return
  done
  IFS=$old_ifs
  echo "bob-herdr: no bob found on PATH, apart from the bob-herdr shim" >&2
  return 1
}

bob=$(real_bob) || exit 127

# Help, version, a headless prompt and Bob's listings, anywhere before `--`,
# run as they are.
for arg do
  case $arg in
    --) break ;;
    -p | --prompt | --prompt=* | -h | --help | -v | --version | --list-tasks | --list-tasks=* | --show-license)
      exec "$bob" "$@"
      ;;
  esac
done

# Bob's options that take a value: those of Bob 2.1.0, and those that
# `bob-herdr install` read from Bob's help.
value_options='--instance-id --workspace --config-dir --mode --max-cost --max-turns --log-level --team-id --disable-tool-groups'
options_file=${BOB_HERDR_OPTIONS:-${XDG_CONFIG_HOME:-$HOME/.config}/bob-herdr/value-options}
if [ -r "$options_file" ] && read -r recorded <"$options_file" && [ -n "$recorded" ]; then
  value_options="$value_options $recorded"
fi

# Bob gets its arguments as they are. The shim only checks what they hold.
# Options and the values of the options above are skipped; after `--`,
# nothing is an option. Bob reads the first remaining word as a command when
# it names one, even after `--`: its headless and management commands run as
# they are, and `chat` is not a prompt. Any other word is a prompt.
prompt=
value=
word=
rest=
for arg do
  if [ -z "$rest" ]; then
    if [ "$value" = 1 ]; then
      value=
      continue
    fi
    if [ "$value" = resume ]; then
      value=
      # Bob reads the word after -r as a task id, unless it is an option.
      case $arg in
        -*) ;;
        *) continue ;;
      esac
    fi
    case " $value_options " in
      *" $arg "*)
        value=1
        continue
        ;;
    esac
    case $arg in
      --)
        rest=1
        continue
        ;;
      -r | --resume)
        value=resume
        continue
        ;;
      -*) continue ;;
    esac
  fi
  [ -n "$arg" ] || continue
  if [ -z "$word" ]; then
    word=1
    case $arg in
      run | mcp | extension | acp) exec "$bob" "$@" ;;
      chat) continue ;;
    esac
  fi
  prompt=1
done

status_enabled || exec "$bob" "$@"

# A helper watches Bob's screen through hc while Bob starts, looking about
# twice a second until Bob's input box is up.
#
# Before its input box, Bob may stop at a question: whether to trust the
# folder, or its sign-in screen. The helper reports each as blocked while it
# is on screen, and clears that report when the question goes: in a folder
# you do not trust, no hook follows to replace it.
#
# Once the input box is up, the helper reports idle if Bob started without a
# prompt. With a prompt it reports nothing: idle would end an `hc wait`
# early, and Bob's hook reports working once Bob has the prompt.
#
# An earlier program may have left one of these texts on the screen. The
# first look comes before Bob draws, and if it shows one of them, nothing
# counts until a look shows none, which is Bob clearing the screen.
#
# The helper and the shim share a folder: `pid` holds Bob's process id, and
# `exited` appears once Bob has exited. The helper checks both before it
# reports, so it never reports for a Bob that is gone.
state=
helper=
ready=${BOB_HERDR_READY_TEXT:-/ for commands}
signin=${BOB_HERDR_SIGNIN_TEXT:-Complete sign-in in your browser|in your browser to sign in}
trust=${BOB_HERDR_TRUST_TEXT:-Do you trust this folder}
bob_alive() {
  [ ! -e "$state/exited" ] && [ -s "$state/pid" ] && kill -0 "$(cat "$state/pid")" 2>/dev/null
}
stop_helper() {
  if [ -n "$helper" ]; then
    { : >"$state/exited"; } 2>/dev/null
    pkill -P "$helper" 2>/dev/null
    kill "$helper" 2>/dev/null
    wait "$helper" 2>/dev/null
  fi
  [ -z "$state" ] || rm -rf "$state"
}
if [ -n "${HC_TERMINAL_ID:-}" ] && command -v hc >/dev/null 2>&1; then
  # Until Bob runs, Ctrl-C ends the shim: the helper must not outlive it.
  trap 'stop_helper; exit 130' INT
  # A shim that was killed leaves its folder behind: remove the folders
  # whose Bob is gone.
  for old in "${TMPDIR:-/tmp}"/bob-herdr.*; do
    [ -s "$old/pid" ] && read -r old_pid <"$old/pid" && ! kill -0 "$old_pid" 2>/dev/null && rm -rf "$old"
  done
  state=$(mktemp -d "${TMPDIR:-/tmp}/bob-herdr.XXXXXX")
  term=$HC_TERMINAL_ID
  (
    trap '' INT
    fresh=
    asked=
    looks=$((${BOB_HERDR_READY_TIMEOUT:-600} * 2))
    while [ "$looks" -gt 0 ] && [ ! -e "$state/exited" ]; do
      looks=$((looks - 1))
      # Without HC_TERMINAL_ID, hc acts for nobody. A look that fails says
      # nothing about the screen.
      if ! screen=$(env -u HC_TERMINAL_ID hc read "$term" --lines 40 2>/dev/null); then
        sleep 0.5
        continue
      fi
      found=
      if printf '%s' "$screen" | grep -Eq "$trust"; then
        found=trust
      elif printf '%s' "$screen" | grep -Eq "$signin"; then
        found=signin
      else
        case $screen in
          *"$ready"*) found=ready ;;
        esac
      fi
      if [ -z "$fresh" ]; then
        if [ -n "$found" ]; then
          sleep 0.3
          continue
        fi
        fresh=1
      fi
      if [ -n "$asked" ] && [ "$found" != "$asked" ]; then
        # Only our own report: a hook may have reported since. If the
        # status cannot be read, the next look tries again.
        if ! status=$(env -u HC_TERMINAL_ID hc get "$term" --json 2>/dev/null); then
          sleep 0.5
          continue
        fi
        case $status in
          *"\"msg\":\"$msg\""*) report "state=clear" ;;
        esac
        asked=
      fi
      case $found in
        ready)
          if [ -z "$prompt" ] && bob_alive; then
            # Text typed before the input box was up may already be a
            # prompt: a hook's working or blocked report stays.
            case $(env -u HC_TERMINAL_ID hc get "$term" --json 2>/dev/null) in
              *'"app":"bob"'*'"state":"working"'* | *'"app":"bob"'*'"state":"blocked"'*) ;;
              *) report "state=idle:app=bob" ;;
            esac
          fi
          exit 0
          ;;
        trust)
          kind=permission
          msg='Bob asks whether to trust this folder'
          ;;
        signin)
          kind=auth
          msg='Sign in to Bob in your browser'
          ;;
      esac
      if [ -n "$found" ] && [ "$found" != "$asked" ]; then
        bob_alive || exit 0
        report "state=blocked:kind=$kind:app=bob:msg=$(printf '%s' "$msg" | base64 | tr -d '\n')"
        asked=$found
      fi
      sleep 0.5
    done
  ) 2>/dev/null &
  helper=$!
fi

# Bob runs in the background so the shim knows its process id. Its stdin is
# the terminal (saved in fd 3), not the /dev/null a background job gets.
# From here on Ctrl-C is Bob's: it shares the terminal's process group.
exec 3<&0
trap : INT
"$bob" "$@" <&3 3<&- &
bob_pid=$!
exec 3<&-
[ -z "$state" ] || echo "$bob_pid" >"$state/pid"

# TERM and HUP for the shim go to Bob; the cleanup below runs once Bob exits.
trap 'kill -TERM "$bob_pid" 2>/dev/null' TERM
trap 'kill -HUP "$bob_pid" 2>/dev/null' HUP
while :; do
  wait "$bob_pid"
  rc=$?
  kill -0 "$bob_pid" 2>/dev/null || break
done

stop_helper
report "state=clear"
exit $rc
