#!/bin/sh
# bob-herdr: OSC 7501 status for IBM Bob, and Bob in the Herdr app.
set -eu

# Bob's hooks: a submitted prompt is working, an approval prompt or a
# question is blocked, a finished turn is done, `/clear` is idle. Idle at
# launch comes from the shim: Bob runs its SessionStart hook before its input
# box is ready, and also when it starts with a prompt. Bob runs `hook` on
# every event and waits for it, so this runs before anything else here: it
# starts no process when reports are off, and only node when they are on.
# Bob's settings call this file by its own path, so a link is rare.
if [ "${1:-}" = hook ]; then
  if [ -L "$0" ]; then self=$(realpath "$0"); else self=$0; fi
  case $self in
    */*) lib=${self%/*}/../lib ;;
    *) lib=../lib ;;
  esac
  . "$lib/status.sh"
  status_enabled || exit 0
  exec node "$lib/hook.mjs"
fi

self=$(realpath "$0")
root=$(dirname "$(dirname "$self")")

bin_dir=${BOB_HERDR_BIN_DIR:-$HOME/.local/bin}
bob_settings=${BOB_HERDR_BOB_SETTINGS:-$HOME/.bob/settings/settings.json}
app_home=${BOB_HERDR_APP_HOME:-$HOME/.config/herdr-app}
options_file=${BOB_HERDR_OPTIONS:-${XDG_CONFIG_HOME:-$HOME/.config}/bob-herdr/value-options}
config() { node "$root/lib/config.mjs" "$@"; }

usage() {
  cat <<EOF
Usage: bob-herdr <command>

Commands:
  install     Link bob-herdr and the bob shim into $bin_dir, add the
              status hooks to Bob's settings, and add Bob to the Herdr app
  uninstall   Remove what install added
  status      Show what is installed and which bob runs
  hook        Report a Bob hook event as OSC 7501 (Bob runs this)
EOF
}

# Sets bob_version to what `bob --version` prints, empty when bob does not
# run, and succeeds when that is older than 2.1.0, the first Bob that takes
# a prompt as an argument.
bob_too_old() {
  bob_version=$(bob --version 2>/dev/null | sed -n '1s/^\([0-9][0-9]*\.[0-9][0-9.]*\).*/\1/p')
  [ -n "$bob_version" ] || return 1
  major=${bob_version%%.*}
  minor=${bob_version#*.}
  minor=${minor%%.*}
  [ "$major" -lt 2 ] || { [ "$major" -eq 2 ] && [ "$minor" -lt 1 ]; }
}

# Bob's mascot from an installed IBM Bob IDE, else our own glyph.
icon_source() {
  for app in "$HOME"/Applications/IBM\ Bob*.app /Applications/IBM\ Bob*.app; do
    svg="$app/Contents/Resources/app/out/media/code-icon.svg"
    if [ -f "$svg" ]; then
      printf '%s\n' "$svg"
      return
    fi
  done
  printf '%s\n' "$root/share/bob.svg"
}

# Links $bin_dir/<name> to bin/<name> here. A broken link is replaced; a
# file or a working link to anything else is left alone.
link() {
  name=$1
  target="$root/bin/$name"
  dest="$bin_dir/$name"
  if [ -e "$dest" ] && [ "$(realpath "$dest")" != "$target" ]; then
    echo "Skipped $dest: it is not a bob-herdr link. Remove it and run install again."
    return
  fi
  ln -sfn "$target" "$dest"
  echo "Linked $dest"
}

unlink_ours() {
  dest="$bin_dir/$1"
  if [ -L "$dest" ] && [ "$(realpath "$dest" 2>/dev/null)" = "$root/bin/$1" ]; then
    rm "$dest"
    echo "Removed $dest"
  fi
}

install() {
  mkdir -p "$bin_dir"
  link bob-herdr
  link bob
  if [ "$(command -v bob 2>/dev/null || :)" != "$bin_dir/bob" ]; then
    echo "Warning: bob runs $(command -v bob 2>/dev/null || echo nothing), not the shim. Put $bin_dir ahead of it on PATH."
  fi

  # The hooks call this clone directly, so they work even if a link was
  # skipped. An older Bob does not know all their events, and Bob ignores
  # every hook in a settings file that names an event it does not know.
  if bob_too_old; then
    echo "Skipped the status hooks: Bob $bob_version is older than 2.1.0, which bob-herdr needs. Update Bob and run install again."
  else
    config hooks-add "$bob_settings" "\"$root/bin/bob-herdr\" hook"
    echo "Added the status hooks to $bob_settings"
  fi

  # The shim must tell an option's value from a prompt. Bob's help lists
  # the options that take one, as `--mode <mode>`; an optional value, as in
  # `--resume [task-id]`, is not one of them.
  options=$({
    bob --help
    bob chat --help
  } 2>/dev/null |
    sed -n -E 's/^ +(-[A-Za-z0-9]), (--[A-Za-z0-9][A-Za-z0-9-]*) <.*/\1 \2/p; s/^ +(--[A-Za-z0-9][A-Za-z0-9-]*) <.*/\1/p; s/^ +(-[A-Za-z0-9]) <.*/\1/p' |
    tr ' ' '\n' | sort -u | tr '\n' ' ')
  options=${options% }
  if [ -n "$options" ]; then
    mkdir -p "$(dirname "$options_file")"
    printf '%s\n' "$options" >"$options_file"
    echo "Recorded Bob's options that take a value in $options_file"
  else
    echo "Kept the built-in list of Bob's options: bob --help listed none"
  fi

  if [ -d "$app_home" ]; then
    icon=$(icon_source)
    tint=false
    [ "$icon" = "$root/share/bob.svg" ] && tint=true
    mkdir -p "$app_home/bob-herdr"
    cp "$icon" "$app_home/bob-herdr/bob.svg"
    # The full path: the app starts agents through herdr-core, whose PATH
    # may predate yours and find the real Bob first.
    config program-add "$app_home/programs.json" bob-herdr/bob.svg "$tint" "$bin_dir/bob"
    echo "Added IBM Bob to $app_home/programs.json"
  else
    echo "Skipped the Herdr app: $app_home does not exist"
  fi
}

uninstall() {
  unlink_ours bob
  unlink_ours bob-herdr
  config hooks-remove "$bob_settings"
  echo "Removed the status hooks from $bob_settings"
  if [ -f "$options_file" ]; then
    rm "$options_file"
    [ -n "${BOB_HERDR_OPTIONS:-}" ] || rmdir "$(dirname "$options_file")" 2>/dev/null || :
    echo "Removed $options_file"
  fi
  if [ -d "$app_home" ]; then
    config program-remove "$app_home/programs.json"
    rm -rf "$app_home/bob-herdr"
    echo "Removed IBM Bob from $app_home/programs.json"
  fi
}

status() {
  for name in bob-herdr bob; do
    dest="$bin_dir/$name"
    if [ -L "$dest" ] && [ "$(realpath "$dest" 2>/dev/null)" = "$root/bin/$name" ]; then
      echo "$name: linked at $dest"
    else
      echo "$name: not linked"
    fi
  done
  echo "bob runs: $(command -v bob 2>/dev/null || echo nothing)"
  if [ -s "$options_file" ]; then
    echo "Bob's options that take a value: recorded in $options_file"
  else
    echo "Bob's options that take a value: built-in list"
  fi
  if bob_too_old; then
    echo "Bob version: $bob_version (bob-herdr needs 2.1.0 or later)"
  else
    echo "Bob version: ${bob_version:-unknown}"
  fi
  echo "Status hooks in $bob_settings: $(config hooks-count "$bob_settings")"
  if [ -d "$app_home" ]; then
    entry=$(config program-show "$app_home/programs.json")
    echo "Herdr app entry: ${entry:-none}"
  else
    echo "Herdr app: not installed"
  fi
}

case ${1:-} in
  install) install ;;
  uninstall) uninstall ;;
  status) status ;;
  -h | --help | help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
